{
  "openapi": "3.0.3",
  "info": { "title": "Demo users API", "version": "1.0.0" },
  "paths": {
    "/api/users": {
      "get": { "summary": "List users", "responses": { "200": { "description": "ok" } } },
      "post": { "summary": "Create user", "responses": { "201": { "description": "created" }, "400": { "description": "invalid" } } }
    },
    "/api/users/{id}": {
      "get": { "summary": "Get user", "responses": { "200": { "description": "ok" }, "404": { "description": "missing" } } },
      "patch": { "summary": "Update user", "responses": { "200": { "description": "ok" } } },
      "delete": { "summary": "Delete user", "responses": { "204": { "description": "deleted" } } }
    },
    "/api/users/{id}/avatar": {
      "put": { "summary": "Upload avatar", "responses": { "200": { "description": "ok" } } }
    },
    "/api/health": {
      "get": { "summary": "Health check", "responses": { "200": { "description": "ok" } } }
    }
  }
}
